# Database (docker-compose.dev.yml ile uyumlu)
DATABASE_URL=postgresql://eserpromo:eserpromo@localhost:5432/eserpromo

# Site
SITE_URL=http://localhost:3000
SITE_DOMAIN=eserpromo.com
AUTH_SECRET=

# Etkin / Birikim Promosyon API (sadece sync job)
API_URL=https://www.birikimpromosyon.com/api/json/
API_HASH=
EBAYI_EPOSTA=
SITE_OUTBOUND_IP=

# Yerel görsel depolama (hotlink yasak — görseller buraya indirilir)
STORAGE_PATH=./storage

# Sync koruması (anlık API Reader yasak)
SYNC_MIN_INTERVAL_MS=3600000
SYNC_REQUEST_GAP_MS=500

# Iyzico (kart verisi bu sunucuya gelmez)
IYZICO_URI=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
