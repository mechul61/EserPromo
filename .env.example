# Database (docker-compose.dev.yml ile uyumlu)
DATABASE_URL=postgresql://eserpromo:eserpromo@localhost:5432/eserpromo

# Site
SITE_URL=http://localhost:3000
SITE_DOMAIN=eserpromo.com
AUTH_SECRET=

# Yönetim paneli (virgülle birden fazla e-posta)
ADMIN_EMAIL=

# Etkin / Birikim Promosyon API (sadece sync job)
API_URL=https://www.birikimpromosyon.com/api/json/
API_HASH=
EBAYI_EPOSTA=
SITE_OUTBOUND_IP=

# Yerel görsel depolama (hotlink yasak — görseller buraya indirilir)
STORAGE_PATH=./storage

# Sync koruması (anlık API Reader yasak)
SYNC_MIN_INTERVAL_MS=3600000
SYNC_REQUEST_GAP_MS=500

# Iyzico (kart verisi bu sunucuya gelmez)
IYZICO_URI=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Google reCAPTCHA v2 (checkbox) — canlıda kendi anahtarlarınızı koyun
# https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Şifre sıfırlama ve favori indirim e-postaları (yoksa e-posta gönderilmez; Bildirimlerim yine dolar)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=info@eserpromo.com
