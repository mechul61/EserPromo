// EserPromo katalog + e-ticaret
//
// Katalog: her Etkin urun_id = Product (renk/ebat). Aynı skuGroup = ProductGroup.
// Vitrin URL'si grubun slug'ıdır; sepet/sipariş her zaman Product (varyant) id kullanır.
// Kart verisi asla saklanmaz — ödeme Iyzico'da.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  super_admin
  editor
  support
  content
}

enum CustomerGroup {
  retail
  wholesale
  vip
}

enum CustomerSource {
  website
  social
  email
  other
}

enum OrderStatus {
  draft
  pending_payment
  paid
  preparing
  shipped
  completed
  cancelled
  failed
}

enum PaymentStatus {
  pending
  success
  failure
  refunded
}

enum CouponKind {
  general
  shipping
  special
  product
}

enum CouponDiscountKind {
  percent
  amount
}

model Category {
  id             Int            @id
  parentId       Int?
  name           String
  slug           String         @unique
  description    String?        @db.Text
  imageUrl       String?
  imageLocalPath String?
  iconUrl        String?
  sortOrder      Int            @default(0)
  showOnHomepage Boolean        @default(false)
  homepageOrder  Int            @default(0)
  sourceMd5      String?
  products       Product[]
  groups         ProductGroup[]
  adminLocked    Boolean        @default(false)
  removed        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([parentId])
  @@index([showOnHomepage, homepageOrder])
  @@index([removed])
}

/// Varyant ailesi — Google'daki tek kanonik ürün sayfası.
model ProductGroup {
  skuGroup    String    @id
  slug        String    @unique
  name        String
  description String?   @db.Text
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([categoryId])
}

/// Etkin tekil ürün / varyant. Stok, fiyat, sepet satırı buradan.
model Product {
  id             Int      @id
  categoryId     Int
  category       Category @relation(fields: [categoryId], references: [id])
  sku            String
  skuGroup       String
  group          ProductGroup @relation(fields: [skuGroup], references: [skuGroup])
  name           String
  title          String?
  description    String?  @db.Text
  color          String?
  size           String?
  features       String?  @db.Text
  sortOrder      Int      @default(0)
  catalogPage    Int?
  isManufactured Boolean  @default(false)
  discountLocked Boolean  @default(false)
  price          Decimal  @db.Decimal(12, 3)
  vatRate        Decimal  @db.Decimal(5, 2) @default(20)
  stockTotal     Int      @default(0)
  stockCenter    Int      @default(0)
  stockIstanbul  Int      @default(0)
  stockTopkapi   Int      @default(0)
  traseUrl       String?
  traseFileName  String?
  traseFileSize  Int?
  sourceMd5      String?
  isGroupPrimary Boolean  @default(false)
  /// Eski/varyant slug; 301 ile grup URL'sine yönlenir.
  slug           String   @unique
  isActive       Boolean  @default(true)
  showOnHomepage Boolean  @default(true)
  adminLocked    Boolean  @default(false)
  removed        Boolean  @default(false)
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  favorites      Favorite[]
  notifications  UserNotification[]
  stockNotifies  StockNotifyRequest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
  @@index([sku])
  @@index([skuGroup, isGroupPrimary])
  @@index([isActive, sortOrder])
  @@index([isActive, showOnHomepage, isGroupPrimary])
  @@index([removed])
}

/// Stok yokken “Gelince Haber Ver” abonelikleri.
model StockNotifyRequest {
  id         String    @id @default(cuid())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  userId     String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([productId, email])
  @@index([productId, notifiedAt])
  @@index([email])
  @@index([userId])
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  sourceUrl String
  localPath String
  byteSize  Int?
  createdAt DateTime @default(now())

  @@unique([productId, sortOrder])
  @@index([productId])
}

model User {
  id              String          @id @default(cuid())
  publicNo        Int             @unique @default(autoincrement())
  email           String          @unique
  passwordHash    String
  name            String
  phone           String?
  city            String          @default("")
  role            UserRole        @default(customer)
  customerGroup   CustomerGroup   @default(retail)
  source          CustomerSource  @default(website)
  isActive        Boolean         @default(true)
  blocked         Boolean         @default(false)
  emailVerifiedAt DateTime?
  sessions        Session[]
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  profile         UserProfile?
  favorites       Favorite[]
  notifications   UserNotification[]
  loginEvents     LoginEvent[]
  passwordResets  PasswordResetToken[]
  couponRedemptions CouponRedemption[]
  supportTickets  SupportTicket[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([role, isActive, blocked])
  @@index([customerGroup])
  @@index([city])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  source    String   @default("login")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model UserProfile {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName           String    @default("")
  lastName            String    @default("")
  birthDate           DateTime?
  gender              String?
  avatarPath          String?
  companyName         String    @default("")
  companyTitle        String    @default("")
  taxOffice           String    @default("")
  taxNumber           String    @default("")
  tcKimlik            String    @default("")
  useCorporateDefault Boolean   @default(false)
  notifyEmail         Boolean   @default(true)
  notifySms           Boolean   @default(false)
  notifyWhatsapp      Boolean   @default(false)
  notifyOrder         Boolean   @default(true)
  cookieAnalytics     Boolean   @default(false)
  cookieMarketing     Boolean   @default(false)
  cookieConsentAt     DateTime?
  updatedAt           DateTime  @updatedAt
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  href      String?
  productId Int?
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([productId, type, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("Teslimat")
  fullName    String
  email       String   @default("")
  phone       String
  country     String   @default("Türkiye")
  city        String
  district    String
  postalCode  String   @default("")
  line        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  couponId   String?
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([couponId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id               String      @id @default(cuid())
  publicNumber     String      @unique
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  status           OrderStatus @default(pending_payment)
  /// KDV hariç
  subtotal         Decimal     @db.Decimal(12, 2)
  vatTotal         Decimal     @db.Decimal(12, 2)
  shippingTotal    Decimal     @db.Decimal(12, 2) @default(0)
  /// Ödenecek tutar (KDV dahil)
  grandTotal       Decimal     @db.Decimal(12, 2)
  discountTotal    Decimal     @db.Decimal(12, 2) @default(0)
  couponId         String?
  coupon           Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  currency         String      @default("TRY")
  /// Sipariş anı teslimat kopyası (adres silinse de fatura kalır)
  shipFullName     String
  shipPhone        String
  shipCity         String
  shipDistrict     String
  shipLine         String
  customerNote     String?     @db.Text
  items            OrderItem[]
  payments         Payment[]
  couponRedemption CouponRedemption?
  paidAt           DateTime?
  cargoCompany     String      @default("")
  trackingNo       String      @default("")
  trackingUrl      String      @default("")
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([couponId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  sku         String
  name        String
  color       String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 3)
  vatRate     Decimal @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

/// Iyzico sonuçları. Kart PAN/CVV asla yazılmaz.
model Payment {
  id                     String        @id @default(cuid())
  orderId                String
  order                  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider               String        @default("iyzico")
  status                 PaymentStatus @default(pending)
  amount                 Decimal       @db.Decimal(12, 2)
  currency               String        @default("TRY")
  conversationId         String?       @unique
  providerPaymentId      String?
  errorMessage           String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([orderId])
}

model SyncRun {
  id               Int       @id @default(autoincrement())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("running")
  requestCount     Int       @default(0)
  categoriesUpsert Int       @default(0)
  productsUpserted Int       @default(0)
  imagesDownloaded Int       @default(0)
  errorMessage     String?   @db.Text
}

model TransferBank {
  id          String   @id
  enabled     Boolean  @default(false)
  displayName String   @default("")
  holderName  String   @default("")
  iban        String   @default("")
  accountType String   @default("Vadesiz TL")
  updatedAt   DateTime @updatedAt
}

enum PaymentMethodKind {
  card
  transfer
  wallet
  cod
}

model PaymentMethod {
  id          String             @id @default(cuid())
  key         String             @unique
  name        String
  description String             @default("")
  kind        PaymentMethodKind
  provider    String             @default("")
  isActive    Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([isActive, sortOrder])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Coupon {
  id             String              @id @default(cuid())
  code           String              @unique
  name           String
  description    String?             @db.Text
  kind           CouponKind          @default(general)
  discountKind   CouponDiscountKind
  discountValue  Decimal             @db.Decimal(12, 2)
  minOrderAmount Decimal             @db.Decimal(12, 2) @default(0)
  startsAt       DateTime
  endsAt         DateTime
  usageLimit     Int?
  usedCount      Int                 @default(0)
  perUserLimit   Int                 @default(1)
  isActive       Boolean             @default(true)
  /// Ürün kuponu için Product.id listesi
  productIds     Json?
  carts          Cart[]
  orders         Order[]
  redemptions    CouponRedemption[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([kind])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([couponId, createdAt])
  @@index([userId, createdAt])
}

enum BannerKind {
  banner
  slider
}

enum BannerPlacement {
  hero
  middle_1
  middle_2
  bottom
  side
  category
}

model Banner {
  id         String           @id @default(cuid())
  kind       BannerKind       @default(banner)
  title      String
  href       String           @default("")
  imagePath  String
  width      Int              @default(1920)
  height     Int              @default(600)
  placement  BannerPlacement  @default(hero)
  isActive   Boolean          @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  minAmount  Decimal          @default(0) @db.Decimal(12, 2)
  maxAmount  Decimal          @default(0) @db.Decimal(12, 2)
  views      Int              @default(0)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([kind, isActive, sortOrder])
  @@index([placement, isActive, sortOrder])
}

enum PopupKind {
  subscribe
  promo
  info
}

enum PopupPlacement {
  home
  all
  category
  product
  cart
}

enum PopupDevice {
  all
  desktop
  mobile
}

enum PopupAudience {
  all
  new_visitors
  returning
  logged_in
}

model Popup {
  id              String          @id @default(cuid())
  title           String
  description     String          @default("")
  kind            PopupKind       @default(subscribe)
  placement       PopupPlacement  @default(all)
  device          PopupDevice     @default(all)
  audience        PopupAudience   @default(all)
  isDraft         Boolean         @default(false)
  isActive        Boolean         @default(true)
  imagePath       String          @default("")
  heading         String          @default("")
  body            String          @default("")
  ctaLabel        String          @default("")
  ctaHref         String          @default("")
  couponCode      String          @default("")
  startsAt        DateTime?
  endsAt          DateTime?
  views           Int             @default(0)
  clicks          Int             @default(0)
  conversions     Int             @default(0)
  delaySeconds    Int             @default(2)
  frequencyHours  Int             @default(24)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive, isDraft, startsAt, endsAt])
  @@index([placement, isActive])
}

model PopupSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  popupId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum EmailTemplateCategory {
  order
  customer
  marketing
  other
}

enum EmailTemplateLanguage {
  tr
  en
}

model EmailTemplate {
  id            String                 @id @default(cuid())
  key           String                 @unique
  name          String
  description   String                 @default("")
  subject       String
  heading       String                 @default("")
  body          String                 @db.Text
  ctaLabel      String                 @default("")
  ctaUrl        String                 @default("")
  category      EmailTemplateCategory
  language      EmailTemplateLanguage  @default(tr)
  icon          String                 @default("mail")
  showOrderBox  Boolean                @default(false)
  isActive      Boolean                @default(true)
  isSystem      Boolean                @default(true)
  sentCount     Int                    @default(0)
  failCount     Int                    @default(0)
  lastSentAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([category, isActive])
}

model EmailLog {
  id          String   @id @default(cuid())
  templateKey String
  to          String
  subject     String
  status      String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([templateKey, createdAt])
  @@index([status, createdAt])
}

enum ReportCategory {
  sales
  customer
  product
  finance
  marketing
  other
}

enum ReportKindType {
  table
  chart
}

enum ReportSchedule {
  none
  daily
  weekly
  monthly
}

model SavedReport {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String           @default("")
  source      String
  category    ReportCategory
  kind        ReportKindType   @default(table)
  icon        String           @default("chart")
  schedule    ReportSchedule   @default(none)
  isShared    Boolean          @default(false)
  isSystem    Boolean          @default(true)
  creatorName String           @default("Yönetici")
  runCount    Int              @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  runs        ReportRun[]

  @@index([category, isShared])
  @@index([schedule])
}

model ReportRun {
  id        String      @id @default(cuid())
  reportId  String
  report    SavedReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action    String
  rowCount  Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([reportId, createdAt])
  @@index([action, createdAt])
}

enum SupportCategory {
  order
  returns
  payment
  invoice
  cargo
  account
  other
}

enum SupportPriority {
  low
  medium
  high
}

enum SupportStatus {
  open
  waiting
  resolved
  archived
}

model SupportTicket {
  id           String           @id @default(cuid())
  publicNumber String           @unique
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String           @default("")
  subject      String
  category     SupportCategory  @default(other)
  priority     SupportPriority  @default(medium)
  status       SupportStatus    @default(waiting)
  rating       Int?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     SupportMessage[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     String
  authorName String
  body       String        @db.Text
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model SiteAnalyticsDay {
  day       String @id
  pageViews Int    @default(0)
  visitors  Int    @default(0)
}

model SiteVisitorDay {
  id  String @id
  day String

  @@index([day])
}
